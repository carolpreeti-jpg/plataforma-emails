# Copie este arquivo para ".env" e preencha para usar o Supabase também localmente.
# Sem essas variáveis, o site usa as pastas data/, uploads/ e output/ deste computador.
# Supabase > Project Settings > API: "Project URL" e a chave "service_role" (secreta).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
